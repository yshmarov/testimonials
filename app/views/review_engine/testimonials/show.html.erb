<div class="breadcrumb">
  <%= link_to t('review_engine.dashboard.title', default: 'Testimonials'), root_path %>
  / #<%= @testimonial.id %>
</div>

<h1 class="title-row">
  <span class="badge status-<%= @testimonial.status %>">
    <%= t("review_engine.statuses.#{@testimonial.status}", default: @testimonial.status.humanize) %>
  </span>
  <% if @testimonial.featured? %>
    <span class="badge status-approved">⭐ <%= t('review_engine.dashboard.featured', default: 'Featured') %></span>
  <% end %>
  <% if @testimonial.rating %>
    <span class="stars"><%= '★' * @testimonial.rating %><span class="off"><%= '★' * (5 - @testimonial.rating) %></span></span>
  <% end %>
</h1>

<div class="card pad" style="margin-bottom: 16px;">
  <% if @testimonial.video_attached? %>
    <video class="playback" controls preload="metadata"
           src="<%= testimonial_video_path(@testimonial) %>"></video>
  <% end %>
  <% if @testimonial.body.present? %>
    <p class="message"><%= @testimonial.body %></p>
  <% end %>

  <%# The customer's words are never edited — but the admin can pick a pull-quote. %>
  <%= form_with model: @testimonial, url: testimonial_path(@testimonial), method: :patch,
                class: 'excerpt-form', local: true do |form| %>
    <label class="muted" for="testimonial_excerpt">
      <%= t('review_engine.dashboard.excerpt', default: 'Excerpt (the pull-quote shown by default; leave blank to use the full text)') %>
    </label>
    <%= form.text_area :excerpt, rows: 2, id: 'testimonial_excerpt' %>
    <button class="small" style="margin-top: 8px;">
      <%= t('review_engine.dashboard.save_excerpt', default: 'Save excerpt') %>
    </button>
  <% end %>
</div>

<div class="card pad" style="margin-bottom: 16px;">
  <dl>
    <dt><%= t('review_engine.dashboard.from', default: 'From') %></dt>
    <dd>
      <% if @testimonial.avatar_attached? %>
        <img class="avatar" src="<%= testimonial_avatar_path(@testimonial) %>" alt="">
      <% end %>
      <%= @testimonial.display_name %>
      <% if @testimonial.title_company.present? %> — <%= @testimonial.title_company %><% end %>
    </dd>
    <% if @testimonial.email.present? %>
      <dt><%= t('review_engine.dashboard.email', default: 'Email') %></dt>
      <dd><%= @testimonial.email %></dd>
    <% end %>
    <dt><%= t('review_engine.dashboard.consent', default: 'Consent') %></dt>
    <dd>
      <% if @testimonial.consent_given? %>
        ✓ <span class="muted"><%= @testimonial.consent_text %></span>
      <% else %>
        — <span class="muted"><%= t('review_engine.dashboard.no_consent', default: 'No publication consent. Not served by the API.') %></span>
      <% end %>
    </dd>
    <dt><%= t('review_engine.dashboard.source', default: 'Source') %></dt>
    <dd><%= t("review_engine.sources.#{@testimonial.source}", default: @testimonial.source.humanize) %></dd>
    <% if @testimonial.page_url.present? %>
      <dt><%= t('review_engine.dashboard.page', default: 'Page') %></dt>
      <dd><%= link_to @testimonial.page_url, @testimonial.page_url, target: '_blank', rel: 'noopener' %></dd>
    <% end %>
    <% if @testimonial.locale.present? %>
      <dt><%= t('review_engine.dashboard.locale', default: 'Locale') %></dt>
      <dd><%= @testimonial.locale %></dd>
    <% end %>
    <% if @testimonial.user_agent.present? %>
      <dt><%= t('review_engine.dashboard.browser', default: 'Browser') %></dt>
      <dd class="muted"><%= @testimonial.user_agent %></dd>
    <% end %>
    <dt><%= t('review_engine.dashboard.received', default: 'Received') %></dt>
    <dd><%= @testimonial.created_at %></dd>
  </dl>
</div>

<div class="actions">
  <% (ReviewEngine::Testimonial::STATUSES - [@testimonial.status]).each do |status| %>
    <%= button_to t("review_engine.dashboard.move_to_#{status}", default: "Mark #{status.humanize.downcase}"),
                  testimonial_path(@testimonial),
                  method: :patch, params: { testimonial: { status: status } },
                  class: ('primary' if status == 'approved') %>
  <% end %>
  <%= button_to (@testimonial.featured? ? t('review_engine.dashboard.unfeature', default: 'Unfeature') : t('review_engine.dashboard.feature', default: 'Feature')),
                testimonial_path(@testimonial),
                method: :patch, params: { testimonial: { featured: !@testimonial.featured? } } %>
  <%= button_to t('review_engine.dashboard.delete', default: 'Delete'),
                testimonial_path(@testimonial),
                method: :delete, class: 'danger',
                form: { onsubmit: "return confirm('#{t('review_engine.dashboard.delete_confirm', default: 'Delete this testimonial?')}')" } %>
</div>
